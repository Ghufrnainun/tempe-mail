# TempeMail — required environment variables
# Copy this to .env, then fill in your values.

# Cloudflare API Token (needs Workers, D1, Email Routing, Zone permissions)
CLOUDFLARE_API_TOKEN=YOUR_CF_API_TOKEN

# Cloudflare Account ID (from dashboard → Workers & Pages → Account ID)
CLOUDFLARE_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID

# Comma-separated mail domains (at least 1)
# The first domain is the default for new inboxes.
DOMAINS=mail.example.com

# Web UI host — the subdomain where the web interface lives.
# Must be a subdomain of one of the zones in the account.
WEB_HOST=temp.example.com

# Optional: app name shown in UI
APP_NAME=TempeMail

# Optional: admin key for maintenance endpoints (/api/admin/*)
ADMIN_KEY=change-me

# Optional: manual zone mapping "domain=zone_id,..."
# Leave empty — setup script auto-discovers zone IDs.
CF_ZONE_MAP=
